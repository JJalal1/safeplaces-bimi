# Variable names only. Configure real values privately in the hosting environment.
CUSTOMER_AUTH_URL=
CUSTOMER_AUTH_PUBLIC_KEY=
CUSTOMER_AUTH_ENABLED=false
ADMIN_BOOTSTRAP_PRIVATE=false
SITE_PUBLIC=false
# Enable crawling only after the real site, policies and domain are live.
SITE_INDEXABLE=false
# Set to https://safeplaces.sa only after the domain serves the real production site.
SITE_URL=

# Self-hosted Better Auth (not enabled unless configured).
# Store secrets only in Cloudflare Worker settings or a private local environment.
STANDALONE_AUTH_ENABLED=false
BETTER_AUTH_URL=https://safeplaces.sa
BETTER_AUTH_SECRET=
# Customer email/password is independent of Google and operational notifications.
# Also bind the internal PasswordHasher SQLite Durable Object in Wrangler.
EMAIL_PASSWORD_ENABLED=false
AUTH_EMAIL_FROM=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Immutable verified UUID and confirmed email of the store owner.
STANDALONE_ADMIN_USER_ID=
STANDALONE_ADMIN_EMAIL=

# Operational email; keep disabled until provider and sender are verified.
EMAIL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_FROM=
NOTIFICATION_ADMIN_EMAIL=
# Uses RESEND_API_KEY. AUTH_EMAIL_FROM is a sender fallback.
