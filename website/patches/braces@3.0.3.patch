diff --git a/lib/assert-depth.js b/lib/assert-depth.js
new file mode 100644
--- /dev/null
+++ b/lib/assert-depth.js
@@ -0,0 +1,16 @@
+'use strict';
+
+// Bound recursive walkers, including AST values supplied directly by a caller.
+module.exports = ast => {
+  const stack = [[ast, 0]];
+  let visited = 0;
+  while (stack.length) {
+    const [node, depth] = stack.pop();
+    if (depth > 128 || ++visited > 131072) {
+      throw new RangeError('braces pattern exceeds safe nesting limit');
+    }
+    if (node && Array.isArray(node.nodes)) {
+      for (const child of node.nodes) stack.push([child, depth + 1]);
+    }
+  }
+};
