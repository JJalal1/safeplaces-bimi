{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "safeplaces-production",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": {"enabled": false, "invocation_logs": false},
    "traces": {"enabled": false}
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "safeplaces-production",
    "database_id": "da06d822-b7ee-4a14-b3a5-7bcbc5839821"
  }],
  "r2_buckets": [{
    "binding": "BUCKET",
    "bucket_name": "safeplaces-production-private"
  }],
  "vars": {
    "SITE_PUBLIC": "false",
    "PRODUCTION_LAUNCH_LOCKED": "true",
    "SITE_INDEXABLE": "false",
    "SITE_DEMO_PRICES": "false",
    "STANDALONE_AUTH_ENABLED": "true",
    "CUSTOMER_AUTH_ENABLED": "false",
    "ADMIN_BOOTSTRAP_PRIVATE": "false",
    "EMAIL_NOTIFICATIONS_ENABLED": "false",
    "NOTIFICATION_FROM": "info@safeplaces.sa",
    "NOTIFICATION_REPLY_TO": "info@safeplaces.sa",
    "BETTER_AUTH_URL": "https://safeplaces.sa",
    "GOOGLE_CLIENT_ID": "1065235547111-41hr2mvfp3191sdvbd8c1ma306jkcb78.apps.googleusercontent.com"
  }
}
